rules_version = '2';

// ────────────────────────────────────────────────────────────────
// Área de Lazer Biel — Regras do Firestore
//
// Princípio: negar tudo por padrão. A única superfície pública é a
// leitura de `datas_ocupadas` (sem dado pessoal) e a criação de
// `solicitacoes` com campos validados. Tudo o mais exige o claim
// `admin == true`, aplicado pelo script scripts/set-admin.mjs.
//
// Painel do administrador: apenas o próprio registro admit do admin.
// Logs: apenas create, nunca update/delete, e sempre em nome do
// próprio usuário autenticado (uid == request.auth.uid).
//
// Aplicar com:  firebase deploy --only firestore:rules,firestore:indexes
// (após o deploy do front no Vercel — ver README, seção "Segurança").
// ────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // O claim é emitido pelo Admin SDK; admins provisionados no painel
    // também são aceitos quando seu documento está ativo.
    function eAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // A autorização administrativa da UI também cobre os admins antigos
    // provisionados por um documento ativo em admins/{uid}.
    function eAdminSolicitacoes() {
      return eAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true);
    }

    // Validação de campos aceitos na criação da solicitação do visitante.
    function nomeValido() {
      return request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 120
        && request.resource.data.nome.matches(
             "^[A-Za-zÀ-ÖØ-öø-ÿ0-9][A-Za-zÀ-ÖØ-öø-ÿ0-9 .,\\-]{2,119}$");
    }

    // Telefone é armazenado só com dígitos (DDD + número): 10 ou 11.
    function telefoneValido() {
      return request.resource.data.telefone is string
        && request.resource.data.telefone.matches("^([0-9]{10}|[0-9]{11})$");
    }

    function dataValida() {
      return request.resource.data.data is string
        && request.resource.data.data.matches("^2[0-9]{3}-[0-9]{2}-[0-9]{2}$");
    }

    function convidadosValidos() {
      return request.resource.data.convidados is int
        && request.resource.data.convidados >= 1
        && request.resource.data.convidados <= 200; // limite fixo do servidor
    }

    // Data nunca pode já estar ocupada — o ID do documento em
    // datas_ocupadas é a data (yyyy-MM-dd), o que impede duas reservas.
    function dataEstaLivre() {
      return !exists(/databases/$(database)/documents/datas_ocupadas/$(request.resource.data.data));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Coleções administrativas — somente admin.
    match /reservas/{id} {
      allow read, write: if eAdmin();
      allow read: if eAdminSolicitacoes();
      allow create: if eAdmin()
        || (eAdminSolicitacoes()
          && request.resource.data.keys().hasOnly(
               ['clienteId', 'clienteNome', 'clienteTelefone', 'data', 'entrada', 'saida',
                'valor', 'valorPago', 'statusPagamento', 'statusReserva', 'observacoes',
                'checklist', 'solicitacaoId', 'deleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
          && (eAdmin() || request.resource.data.solicitacaoId is string)
          && request.resource.data.clienteId is string
          && request.resource.data.clienteNome is string
          && request.resource.data.clienteTelefone is string
          && request.resource.data.data is string
          && request.resource.data.data.matches('^2[0-9]{3}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.solicitacaoId is string
          && existsAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId))
          && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId)).data.status == 'aprovada'
          && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId)).data.reservaId == id
          && request.resource.data.statusReserva == 'reservada'
          && request.resource.data.statusPagamento == 'pendente'
          && request.resource.data.valorPago == 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/datas_ocupadas/$(request.resource.data.data))
          && getAfter(/databases/$(database)/documents/datas_ocupadas/$(request.resource.data.data)).data.status == 'reservada'
          && getAfter(/databases/$(database)/documents/datas_ocupadas/$(request.resource.data.data)).data.reservaId == id
          && existsAfter(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId))
          && getAfter(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)).data.telefone == request.resource.data.clienteTelefone);
    }
    match /clientes/{id} {
      allow read, write: if eAdmin();
      allow read: if eAdminSolicitacoes();
      allow create: if eAdminSolicitacoes()
        && request.resource.data.keys().hasOnly(
             ['nome', 'cpf', 'telefone', 'status', 'observacoes', 'tags', 'favorito',
              'totalReservas', 'totalGasto', 'ultimaReserva', 'deleted', 'createdBy',
              'updatedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.nome is string
        && request.resource.data.telefone is string
        && request.resource.data.status == 'confiavel'
        && request.resource.data.totalReservas == 1
        && request.resource.data.totalGasto == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if eAdminSolicitacoes()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['totalReservas', 'ultimaReserva', 'updatedBy', 'updatedAt'])
        && request.resource.data.totalReservas == resource.data.totalReservas + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    match /financeiro/{id} {
      allow read, write: if eAdmin();
    }
    match /despesas/{id} {
      allow read, write: if eAdmin();
    }
    match /bloqueios/{id} {
      allow read, write: if eAdmin();
      allow read: if eAdminSolicitacoes();
    }
    match /lista_espera/{id} {
      allow read, write: if eAdmin();
    }
    match /notificacoes/{id} {
      allow read, write: if eAdmin();
    }
    match /lixeira/{id} {
      allow read, write: if eAdmin();
    }
    match /logs/{id} {
      // Logs só nascem (do próprio usuário autenticado e admin).
      // Ninguém edita; ninguém apaga (nem mesmo o admin).
      allow create: if eAdminSolicitacoes()
        && request.resource.data.usuario == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['usuario', 'usuarioNome', 'acao', 'colecao', 'documento',
              'descricao', 'antes', 'depois', 'deleted', 'createdBy',
              'updatedBy', 'createdAt', 'updatedAt']);
      allow read: if eAdminSolicitacoes();
      allow update, delete: if false;
    }

    // O admin lê e escolhe sua coleção de registros de conta.
    // O próprio usuário admin também pode ler seu registro (login).
    match /admins/{uid} {
      allow read: if eAdmin()
        || (request.auth != null && request.auth.uid == uid);
      allow create: if false; // criar admins é papel do Admin SDK (set-admin.mjs)
      allow update: if eAdmin() && resource.id == request.auth.uid;
      allow delete: if false;
    }

    // Configurações (preço e horários são exibidos no site público,
    // portanto a leitura daqui alimenta o calendário e a reserva sem exposição).
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if eAdmin();
    }

    // Calendário público do site. Documentos id = "yyyy-MM-dd",
    // com apenas {"status": "reservada" | "bloqueada", "updatedAt"}.
    // Nenhum dado pessoal é tocado aqui.
    match /datas_ocupadas/{data} {
      allow get, list: if true;
      allow create: if (eAdmin()
          && data.matches("^2[0-9]{3}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['reservada', 'bloqueada'])
        || (eAdminSolicitacoes()
          && data.matches("^2[0-9]{3}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.keys().hasOnly(['status', 'solicitacaoId', 'reservaId', 'updatedAt'])
          && request.resource.data.status == 'reservada'
          && request.resource.data.solicitacaoId is string
          && request.resource.data.reservaId is string
          && request.resource.data.updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId))
          && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId)).data.status == 'aprovada'
          && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.solicitacaoId)).data.reservaId == request.resource.data.reservaId
          && existsAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)));
      allow update: if eAdmin()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['reservada', 'bloqueada'];
      allow delete: if eAdmin();
    }

    // Solicitação feita pelo visitante (formulário público).
    // createdAt usa documentSentinel (serverTimestamp), nunca dado do cliente.
    match /solicitacoes/{id} {
      allow create: if nomeValido()
        && telefoneValido()
        && dataValida()
        && convidadosValidos()
        && dataEstaLivre()
        && request.resource.data.observacoes is string
        && request.resource.data.observacoes.size() <= 500
        && (request.resource.data.whatsappOptIn == true
          || request.resource.data.whatsappOptIn == false
          || !('whatsappOptIn' in request.resource.data.keys()))
        && request.resource.data.keys().hasOnly(
             ['nome', 'telefone', 'data', 'convidados', 'observacoes', 'whatsappOptIn', 'createdAt']);
      allow read: if eAdminSolicitacoes();
      allow update: if eAdminSolicitacoes()
        && (!('status' in resource.data.keys()) || resource.data.status == 'pendente')
        && request.resource.data.status in ['aprovada', 'recusada']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status', 'reservaId', 'decidedAt', 'decidedBy'])
        && request.resource.data.keys().hasOnly(
             ['nome', 'telefone', 'data', 'convidados', 'observacoes', 'whatsappOptIn', 'createdAt',
              'status', 'reservaId', 'decidedAt', 'decidedBy'])
        && (request.resource.data.status == 'recusada'
          ? !('reservaId' in request.resource.data.keys())
          : request.resource.data.reservaId is string
            && existsAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId))
            && getAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reservaId)).data.data == resource.data.data
            && existsAfter(/databases/$(database)/documents/datas_ocupadas/$(resource.data.data))
            && getAfter(/databases/$(database)/documents/datas_ocupadas/$(resource.data.data)).data.status == 'reservada'
            && getAfter(/databases/$(database)/documents/datas_ocupadas/$(resource.data.data)).data.reservaId == request.resource.data.reservaId);
      allow delete: if false;
    }
  }
}
